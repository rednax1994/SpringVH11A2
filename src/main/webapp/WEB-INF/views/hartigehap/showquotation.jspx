<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<div xmlns:jsp="http://java.sun.com/JSP/Page"
	 xmlns:c="http://java.sun.com/jsp/jstl/core"
	 xmlns:spring="http://www.springframework.org/tags"
	 xmlns:joda="http://www.joda.org/joda/time/tags"
	 xmlns:sec="http://www.springframework.org/security/tags"
	 version="2.0">

	<!-- Add elvariables to help our IDE for code completion -->
	<!--@elvariable id="message" type="edu.avans.hartigehap.web.form.Message"-->
	<!--@elvariable id="customer" type="edu.avans.hartigehap.domain.Customer"-->
	<!--@elvariable id="restaurant" type="edu.avans.hartigehap.domain.Restaurant"-->

	<jsp:directive.page contentType="text/html;charset=UTF-8" />
	<jsp:output omit-xml-declaration="yes" />

	<spring:message code="label_restaurant" var="labelRestaurant" />
	<spring:message code="label_banqueting_subsystem" var="labelBanquetingSubsystem" />
	<spring:message code="label_quotation_info" var="labelQuotationInfo" />
	<spring:message code="label_quotation_number" var="labelQuotationNumber" />
	<spring:message code="label_quotation_update" var="labelQuotationUpdate" />
	<spring:message code="label_quotation_delete" var="labelQuotationDelete" />
	<spring:message code="date_format_pattern" var="dateFormatPattern" />

	<spring:message code="label_customer_photo" var="labelCustomerPhoto" />

	<spring:url value="/restaurants/${restaurant.id}/quotations" var="editQuotationUrl" />
	<spring:url value="/restaurants/${restaurant.id}/quotations" var="deleteQuotationUrl" />
	<spring:url value="/restaurants/${restaurant.id}" var="showRestaurant" />


	<joda:format var="birthDate" value="${customer.birthDate}" pattern="${dateFormatPattern}" />

	<div class="row">
		<h1>${labelBanquetingSubsystem}</h1>
		<h2 class="restaurant muted">${labelRestaurant} <a href="${showRestaurant}">${restaurant.id}</a></h2>

		<c:if test="${not empty message}">
			<div id="message" class="alert alert-info ${message.type}">${message.message}</div>
		</c:if>
	</div>

	<div class="row">
		<div class="panel panel-default">
			<div class="panel-heading">
				<h3 class="panel-title">${labelQuotationInfo}</h3>
				<sec:authorize access="hasRole('ROLE_MANAGER')">
					<span class="pull-right" style="height: 10px;">
						<ul class="nav panel-tabs">
							<li>
								<form action="${editQuotationUrl}/${quotation.id}" method="get">
									<input type="hidden" name="form" />
									<button type="submit" class="btn btn-warning">${labelQuotationUpdate}</button>
								</form>
							</li>
							<li>
								<form action="${deleteQuotationUrl}/${quotation.id}" method="get">
									<input type="hidden" name="delete" />
									<button type="submit" class="btn btn-danger">${labelQuotationDelete}</button>
								</form>
							</li>
						</ul>
					</span>
				</sec:authorize>
			</div>
			<div class="panel-body">

				<div class="input-group">
					<span class="input-group-addon" id="description" path="description">${labelQuotationNumber}</span>
					<input type="text" class="form-control capitalise" id="customerDescription" value="${quotation.number}" readonly="true" />
				</div>

				<p />
			</div>
		</div>
	</div>
</div>
