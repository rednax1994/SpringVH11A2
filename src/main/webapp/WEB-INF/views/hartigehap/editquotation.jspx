<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<div xmlns:jsp="http://java.sun.com/JSP/Page"
	xmlns:c="http://java.sun.com/jsp/jstl/core"
	xmlns:spring="http://www.springframework.org/tags"
	xmlns:form="http://www.springframework.org/tags/form"
	xmlns:sec="http://www.springframework.org/security/tags" version="2.0">

	<!-- Add elvariables to help our IDE for code completion -->
	<!--@elvariable id="quotation" type="edu.avans.hartigehap.domain.Quotation"-->
	<!--@elvariable id="restaurant" type="edu.avans.hartigehap.domain.Restaurant"-->

	<jsp:directive.page contentType="text/html;charset=UTF-8" />
	<jsp:output omit-xml-declaration="yes" />
	<spring:message code="label_restaurant" var="labelRestaurant" />
	<spring:message code="label_banqueting_subsystem"
		var="labelBanquetingSubsystem" />
	<spring:message code="label_quotation_info" var="labelQuotationInfo" />
	<spring:message code="label_quotation_number"
		var="labelQuotationNumber" />
		<spring:message code="label_quotation_amount_of_people"
		var="labelQuotationAmountOfPeople" />
	<spring:message code="label_quotation_event_date"
		var="labelQuotationEventDate" />
	<spring:message code="label_quotation_expiration_date"
		var="labelQuotationExpirationDate" />
	<spring:message code="label_quotation_status"
		var="labelQuotationStatus" />
	<spring:message code="label_quotation_update"
		var="labelQuotationUpdate" />
		<spring:message code="label_create_quotation"
		var="labelQuotationCreate" />
	<spring:message code="label_quotation_delete"
		var="labelQuotationDelete" />
	<spring:message code="label_quotation_accept_and_export"
		var="labelQuotationAcceptAndExport" />
	<spring:message code="label_quotation_preview"
		var="labelQuotationPreview" />
	<spring:message code="date_format_pattern" var="dateFormatPattern" />
	<spring:message code="text_clear" var="textClear" />
	<spring:message code="text_save" var="textSave" />
	<spring:message code="text_browse" var="textBrowse" />
	<spring:message code="text_reset" var="textReset" />
	<spring:url value="/restaurants/${restaurant.id}" var="showRestaurant" />
	<spring:eval
		expression="quotation.id == null ? labelQuotationCreate:labelQuotationUpdate"
		var="formTitle" />

	<div class="row">
		<h1>${labelQuotationInfo}</h1>
		<h2 class="restaurant muted">${labelRestaurant}
			<a href="${showRestaurant}">${restaurant.id}</a>
		</h2>

		<c:if test="${not empty message}">
			<div id="message" class="alert alert-info ${message.type}">${message.message}</div>
		</c:if>
	</div>

	<form:form modelAttribute="quotation" id="quotationUpdateForm"
		enctype="multipart/form-data"
		method="${quotation.id==null ? 'post':'put'}">
		<div class="row">
			<div class="panel panel-default">
				<div class="panel-heading">
					<h3 class="panel-title">${formTitle}</h3>
						<span class="pull-right" style="height: 10px;">
							<ul class="nav panel-tabs">
								<li><button type="submit" class="btn btn-success">${textSave}</button></li>
								<li><button type="reset" class="btn btn-warning">${textReset}</button></li>
							</ul>
						</span>
				</div>
				<div class="panel-body">
					<div class="input-group input-group-100">
						<span class="input-group-addon input-group-min-width"
							id="number" path="number">${labelQuotationNumber}</span>
						<form:input path="number" class="form-control capitalise"
							placeholder="${labelQuotationNumber}"
							aria-describedby="number" />
						<div>
							<form:errors path="number" cssClass="error" />
						</div>
					</div>

					<p />

					<div class="input-group input-group-100">
						<span class="input-group-addon input-group-min-width"
							id="amountOfPeople" path="amountOfPeople">${labelQuotationAmountOfPeople}</span>
						<form:input path="amountOfPeople" class="form-control capitalise"
							placeholder="${labelQuotationAmountOfPeople}"
							aria-describedby="amountOfPeople" />
						<div>
							<form:errors path="amountOfPeople" cssClass="error" />
						</div>
					</div>

					<p />
				</div>
			</div>
		</div>
	</form:form>
</div>